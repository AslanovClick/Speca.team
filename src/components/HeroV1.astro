---
import SpecaMark from './SpecaMark.astro';
import SpecaWordmark from './SpecaWordmark.astro';
import { niches } from '../data/niches';
import { useDict } from '../i18n';

const t = useDict(Astro.currentLocale);
const first = niches[0];
const pad = (n: number) => String(n).padStart(2, '0');
---
<section class="hero" id="top" data-hero>
  <div class="hero__bg" aria-hidden="true">
    <div class="hero__grid"></div>
    <div class="hero__glow"></div>
  </div>

  <div class="container hero__inner">
    <div class="hero__copy">
      <p class="eyebrow" data-reveal style="--d:0">
        <span class="eyebrow__dot"></span>
        {t.hero.eyebrow}
      </p>

      <h1 class="hero__title">
        {t.hero.titleLead.map((line, i) => (
          <span class="hero__line" data-reveal style={`--d:${1 + i}`}><span>{line}</span></span>
        ))}
        <span class="hero__line hero__line--rotator" data-reveal style="--d:3">
          <span class="rotator" aria-live="polite">
            {niches.map((n, i) => (
              <span class:list={['rotator__word', { 'is-active': i === 0 }]} data-word={n.id} aria-hidden={i === 0 ? undefined : 'true'}>
                {Array.from(t.hero.words[n.id]).map((ch, j) => <span style={`--i:${j}`}>{ch}</span>)}
              </span>
            ))}
          </span>
        </span>
      </h1>

      <p class="hero__lead" data-reveal style="--d:4">{t.hero.lead}</p>
    </div>

    <div class="hero__stage" data-stage data-reveal style="--d:3">
      <div class="echo" aria-hidden="true"></div>
      <div class="echo echo--2" aria-hidden="true"></div>
      <template data-ripple-tpl>
        <div class="ripple" aria-hidden="true"></div>
      </template>

      <div class="showcase" data-tilt role="tabpanel" id="niche-panel">
        <div class="showcase__frame">
          <div class="showcase__card">
            <svg class="showcase__union" viewBox="0 0 1092 1410" preserveAspectRatio="none" aria-hidden="true">
              <path fill-rule="evenodd" clip-rule="evenodd" d="M820.409 839.187L944.889 713.358V953.007L1092 808.102V1125.77L803.438 1410H288.562L0 1125.77V808.102L820.409 0V839.187ZM161.251 966.935L546 1345.91L729.883 1164.79V936.291L616.725 1047.75V518.293L161.251 966.935Z" />
            </svg>
            <div class="showcase__halo"></div>
            <div class="showcase__glare"></div>

            <div class="showcase__meta showcase__meta--top">
              <span>Speca / Network</span>
              <span><b data-index>{pad(1)}</b> / {pad(niches.length)}</span>
            </div>

            <svg class="lockup" viewBox="0 0 609 140" role="img" aria-label={first.domain} data-lockup>
              <defs>
                <linearGradient id="lockup-grad" x1="30" y1="0" x2="106" y2="133.6" gradientUnits="userSpaceOnUse">
                  <stop offset="0" style="stop-color: var(--c1)" />
                  <stop offset="1" style="stop-color: var(--c2)" />
                </linearGradient>
              </defs>
              <path d="M133.626 104.756L104.756 133.626H0V29.1446L29.1446 0H133.626V104.756Z" fill="url(#lockup-grad)" />
              <path d="M115.862 47.4634L96.5519 67.5862V42.6515L115.862 22.5287V47.4634Z" fill="#000" />
              <path fill="#000" fill-rule="evenodd" clip-rule="evenodd" d="M85.8038 77.6548L95.8928 67.4588V86.8777L107.816 75.136V100.877L84.4284 123.908H42.6981L19.3104 100.877V75.136L85.8038 9.65517V77.6548ZM32.3797 88.0063L63.5632 118.715L78.4668 104.038V85.5232L69.2955 94.5549V51.6527L32.3797 88.0063Z" />
              <g class="lockup__word"><SpecaWordmark /></g>
              {niches.map((n, i) => (
                <path class:list={['lockup__sub', { 'is-active': i === 0 }]} data-sub={n.id} d={n.subtitle} />
              ))}
            </svg>

            <div class="showcase__meta showcase__meta--bottom">
              <span class="domain" data-domain>{first.domain}</span>
              <a class="status is-live" data-status href={first.url} target="_blank" rel="noopener">
                <span class="status__dot"></span>
                <span data-status-text>{t.hero.live}</span>
              </a>
            </div>
          </div>
        </div>
      </div>

      <div class="picker" role="tablist" aria-label={t.hero.pickNiche}>
        {niches.map((n, i) => (
          <button
            class:list={['picker__item', { 'is-active': i === 0 }]}
            type="button"
            role="tab"
            aria-selected={i === 0 ? 'true' : 'false'}
            aria-controls="niche-panel"
            aria-label={n.domain}
            tabindex={i === 0 ? 0 : -1}
            data-pick={i}
            style={`--i:${i}`}
          >
            <span class="picker__tile"><SpecaMark c1={n.c1} c2={n.c2} /></span>
            <span class="picker__tip">{n.domain.replace('speca', '')}</span>
            <span class="picker__progress"></span>
          </button>
        ))}
      </div>
    </div>
  </div>

  <div class="container">
    <dl class="stats" data-stats>
      {t.hero.stats.map((s, i) => (
        <div class="stats__item" data-reveal style={`--d:${5 + i * 0.5}`}>
          <dt class="stats__value">
            {s.value !== null
              ? <span data-count={s.value}>{s.value.toLocaleString('uk-UA')}</span>
              : <span>{s.text}</span>}
          </dt>
          <dd class="stats__label">{s.label}</dd>
        </div>
      ))}
      <p class="stats__note" data-reveal style="--d:7">* {t.hero.statsNote}</p>
    </dl>
  </div>
</section>

<script
  is:inline
  define:vars={{
    NICHES: niches.map(({ id, domain, c1, c2, status, url }) => ({ id, domain, c1, c2, status, url })),
    LABELS: { live: t.hero.live, soon: t.hero.soon },
  }}
>
  window.__SPECA_NICHES__ = { NICHES, LABELS };
</script>

<script>
  type NicheLite = { id: string; domain: string; c1: string; c2: string; status: 'live' | 'soon'; url?: string };
  const { NICHES, LABELS } = (window as any).__SPECA_NICHES__ as {
    NICHES: NicheLite[];
    LABELS: { live: string; soon: string };
  };

  const hero = document.querySelector<HTMLElement>('[data-hero]')!;
  const stage = hero.querySelector<HTMLElement>('[data-stage]')!;
  const tilt = hero.querySelector<HTMLElement>('[data-tilt]')!;
  const tabs = [...hero.querySelectorAll<HTMLButtonElement>('[data-pick]')];
  const words = [...hero.querySelectorAll<HTMLElement>('[data-word]')];
  const subs = [...hero.querySelectorAll<SVGPathElement>('[data-sub]')];
  const lockup = hero.querySelector<SVGSVGElement>('[data-lockup]')!;
  const indexEl = hero.querySelector<HTMLElement>('[data-index]')!;
  const domainEl = hero.querySelector<HTMLElement>('[data-domain]')!;
  const statusEl = hero.querySelector<HTMLAnchorElement>('[data-status]')!;
  const statusText = hero.querySelector<HTMLElement>('[data-status-text]')!;
  const rippleTpl = hero.querySelector<HTMLTemplateElement>('[data-ripple-tpl]')!;

  const root = document.documentElement;
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const finePointer = matchMedia('(pointer: fine)').matches;
  let current = 0;

  function select(i: number, { focus = false } = {}) {
    if (i === current) return;
    const prev = current;
    current = (i + NICHES.length) % NICHES.length;
    const n = NICHES[current];

    root.style.setProperty('--c1', n.c1);
    root.style.setProperty('--c2', n.c2);

    // «Уходящее» слово уезжает вверх, затем невидимым возвращается вниз
    words.forEach((w, k) => {
      w.classList.toggle('is-active', k === current);
      w.classList.toggle('is-leaving', k === prev);
      w.toggleAttribute('aria-hidden', k !== current);
    });
    const leaving = words[prev];
    setTimeout(() => {
      if (!leaving.classList.contains('is-active')) leaving.classList.remove('is-leaving');
    }, 900);
    subs.forEach((s, k) => s.classList.toggle('is-active', k === current));
    tabs.forEach((b, k) => {
      const on = k === current;
      b.classList.toggle('is-active', on);
      b.setAttribute('aria-selected', String(on));
      b.tabIndex = on ? 0 : -1;
    });
    if (focus) tabs[current].focus();

    lockup.setAttribute('aria-label', n.domain);
    indexEl.textContent = String(current + 1).padStart(2, '0');
    domainEl.textContent = n.domain;
    const live = n.status === 'live';
    statusEl.classList.toggle('is-live', live);
    statusText.textContent = live ? LABELS.live : LABELS.soon;
    if (live && n.url) {
      statusEl.href = n.url;
      statusEl.removeAttribute('aria-disabled');
      statusEl.tabIndex = 0;
    } else {
      statusEl.removeAttribute('href');
      statusEl.setAttribute('aria-disabled', 'true');
      statusEl.tabIndex = -1;
    }

    if (!reduced) ripple();
  }

  function ripple() {
    const el = rippleTpl.content.firstElementChild!.cloneNode(true) as HTMLElement;
    stage.appendChild(el);
    el.addEventListener('animationend', () => el.remove(), { once: true });
  }


  // Выбор ниши
  tabs.forEach((b, k) => {
    b.addEventListener('click', () => select(k));
    b.addEventListener('keydown', (e) => {
      const map: Record<string, number> = { ArrowRight: 1, ArrowDown: 1, ArrowLeft: -1, ArrowUp: -1 };
      if (e.key in map) { e.preventDefault(); select(current + map[e.key], { focus: true }); }
      if (e.key === 'Home') { e.preventDefault(); select(0, { focus: true }); }
      if (e.key === 'End') { e.preventDefault(); select(NICHES.length - 1, { focus: true }); }
    });
  });

  // Автопрокрутка: полоса прогресса у активной плитки задаёт ритм
  if (!reduced) {
    hero.classList.add('is-autoplay');
    tabs.forEach((b) =>
      b.querySelector('.picker__progress')!.addEventListener('animationend', (e) => {
        if ((e as AnimationEvent).animationName === 'progress' && b.classList.contains('is-active')) select(current + 1);
      }),
    );
    const pause = (on: boolean) => hero.classList.toggle('is-paused', on);
    stage.addEventListener('pointerenter', () => pause(true));
    stage.addEventListener('pointerleave', () => pause(false));
    stage.addEventListener('focusin', () => pause(true));
    stage.addEventListener('focusout', () => pause(false));
    new IntersectionObserver(([e]) => hero.classList.toggle('is-offscreen', !e.isIntersecting), {
      threshold: 0.15,
    }).observe(hero);
  }

  // Наклон карточки за курсором
  if (finePointer && !reduced) {
    let raf = 0;
    stage.addEventListener('pointermove', (e) => {
      cancelAnimationFrame(raf);
      raf = requestAnimationFrame(() => {
        const r = tilt.getBoundingClientRect();
        const x = (e.clientX - r.left) / r.width;
        const y = (e.clientY - r.top) / r.height;
        tilt.style.setProperty('--rx', `${(0.5 - y) * 8}deg`);
        tilt.style.setProperty('--ry', `${(x - 0.5) * 10}deg`);
        tilt.style.setProperty('--gx', `${x * 100}%`);
        tilt.style.setProperty('--gy', `${y * 100}%`);
      });
    });
    stage.addEventListener('pointerleave', () => {
      tilt.style.setProperty('--rx', '0deg');
      tilt.style.setProperty('--ry', '0deg');
    });
  }

  // Счётчики
  const counters = [...hero.querySelectorAll<HTMLElement>('[data-count]')];
  const fmt = new Intl.NumberFormat('uk-UA');
  if (!reduced) {
    counters.forEach((c) => (c.textContent = '0'));
    const run = () => {
      const start = performance.now();
      const dur = 1600;
      const tick = (now: number) => {
        const p = Math.min(1, (now - start) / dur);
        const eased = 1 - Math.pow(1 - p, 4);
        counters.forEach((c) => (c.textContent = fmt.format(Math.round(+c.dataset.count! * eased))));
        if (p < 1) requestAnimationFrame(tick);
      };
      requestAnimationFrame(tick);
    };
    setTimeout(run, 900);
  }
</script>

<style>
  .hero {
    --cycle: 2600ms;
    position: relative;
    isolation: isolate;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding-top: calc(var(--header-h) + 48px);
    padding-bottom: 40px;
    overflow: hidden;
  }

  /* ---------- фон ---------- */
  .hero__bg { position: absolute; inset: 0; z-index: -1; pointer-events: none; }
  .hero__grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(to right, rgb(255 255 255 / 0.045) 1px, transparent 1px),
      linear-gradient(to bottom, rgb(255 255 255 / 0.045) 1px, transparent 1px);
    background-size: 72px 72px;
    background-position: center top;
    mask-image: radial-gradient(ellipse 70% 60% at 65% 40%, #000 20%, transparent 75%);
    -webkit-mask-image: radial-gradient(ellipse 70% 60% at 65% 40%, #000 20%, transparent 75%);
  }
  .hero__glow {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(38% 46% at 74% 42%, color-mix(in oklab, var(--c1) 26%, transparent), transparent 72%),
      radial-gradient(30% 40% at 10% 100%, color-mix(in oklab, var(--c2) 12%, transparent), transparent 70%);
  }

  .hero__inner {
    display: grid;
    grid-template-columns: minmax(0, 1.08fr) minmax(0, 0.92fr);
    align-items: center;
    gap: clamp(32px, 5vw, 72px);
    flex: 1;
  }

  /* ---------- текст ---------- */
  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 8px 14px 8px 12px;
    margin-bottom: 28px;
    border: 1px solid var(--line-strong);
    background: rgb(255 255 255 / 0.02);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-2);
    border-radius: var(--radius);
  }
  .eyebrow__dot {
    position: relative;
    width: 7px; height: 7px;
    border-radius: 50%;
    background: var(--c1);
    box-shadow: 0 0 12px var(--c1);
  }
  .eyebrow__dot::after {
    content: '';
    position: absolute;
    inset: -4px;
    border-radius: 50%;
    border: 1px solid var(--c1);
    animation: ping 2s var(--ease-out) infinite;
  }
  @keyframes ping { from { opacity: 0.9; transform: scale(0.6); } to { opacity: 0; transform: scale(1.6); } }

  .hero__title {
    font-family: var(--font-display);
    font-weight: 700;
    font-stretch: 88%;
    font-size: clamp(40px, 6.1vw, 92px);
    line-height: 0.98;
    letter-spacing: -0.01em;
    text-transform: uppercase;
  }
  .hero__line { display: block; }
  .hero__line--rotator { margin-top: 0.02em; }

  .rotator {
    display: inline-grid;
    padding: 0.04em 0.06em 0.1em 0;
    overflow: hidden;
    vertical-align: top;
  }
  .rotator__word {
    grid-area: 1 / 1;
    white-space: nowrap;
    color: var(--c1);
  }
  .rotator__word > span {
    display: inline-block;
    opacity: 0;
    transform: translateY(80%);
    transition:
      transform 0.7s var(--ease-out) calc(var(--i) * 28ms),
      opacity 0.5s var(--ease-out) calc(var(--i) * 28ms);
  }
  .rotator__word.is-active > span { opacity: 1; transform: none; }
  .rotator__word.is-leaving > span {
    opacity: 0;
    transform: translateY(-80%);
    transition-duration: 0.45s, 0.3s;
    transition-delay: calc(var(--i) * 18ms);
  }

  .hero__lead {
    max-width: 34em;
    margin-top: 32px;
    font-size: clamp(16px, 1.25vw, 18.5px);
    line-height: 1.65;
    color: var(--text-2);
  }

  /* ---------- сцена с логотипом ---------- */
  .hero__stage {
    position: relative;
    display: grid;
    gap: 22px;
    perspective: 1400px;
  }

  .echo, .ripple {
    position: absolute;
    left: 50%;
    top: 44%;
    width: 128%;
    aspect-ratio: 1091 / 656;
    translate: -50% -50%;
    border: 1px solid rgb(255 255 255 / 0.07);
    border-radius: 28px;
    pointer-events: none;
    z-index: -1;
  }
  .echo--2 { width: 158%; border-color: rgb(255 255 255 / 0.04); border-radius: 40px; }
  .ripple { width: 102%; border-color: var(--c1); border-radius: var(--radius-lg); }
  .ripple { animation: ripple 1.6s var(--ease-out) forwards; }
  @keyframes ripple {
    from { opacity: 0.8; scale: 1; }
    to { opacity: 0; scale: 1.55; }
  }

  .showcase {
    --rx: 0deg; --ry: 0deg; --gx: 50%; --gy: 30%;
    transform: rotateX(var(--rx)) rotateY(var(--ry));
    transform-style: preserve-3d;
    transition: transform 0.6s var(--ease-out);
  }
  .showcase__frame {
    padding: 1px;
    border-radius: var(--radius-lg);
    background: linear-gradient(
      140deg,
      color-mix(in oklab, var(--c1) 80%, transparent) 0%,
      rgb(255 255 255 / 0.1) 30%,
      rgb(255 255 255 / 0.06) 70%,
      color-mix(in oklab, var(--c2) 60%, transparent) 100%
    );
    filter: drop-shadow(0 30px 60px rgb(0 0 0 / 0.6)) drop-shadow(0 0 60px color-mix(in oklab, var(--c1) 18%, transparent));
  }
  .showcase__card {
    position: relative;
    border-radius: calc(var(--radius-lg) - 1px);
    aspect-ratio: 1091 / 656;
    background: #000;
    overflow: hidden;
    container-type: inline-size;
  }
  /* Фоновая «Union»-форма — как на макетах логотипов в Figma */
  .showcase__union {
    position: absolute;
    left: -0.1%;
    top: -64.8%;
    width: 100.1%;
    height: 214.9%;
    fill: #0f0f0f;
  }
  .showcase__halo {
    position: absolute;
    inset: 0;
    background: radial-gradient(34% 58% at 31% 50%, color-mix(in oklab, var(--c1) 30%, transparent), transparent 70%);
    mix-blend-mode: screen;
  }
  .showcase__glare {
    position: absolute;
    inset: 0;
    background: radial-gradient(40% 60% at var(--gx) var(--gy), rgb(255 255 255 / 0.07), transparent 70%);
    pointer-events: none;
  }

  .lockup {
    position: absolute;
    left: 22.09%;
    top: 39.33%;
    width: 55.76%;
    overflow: visible;
  }
  .lockup__word { color: #fff; }
  .lockup__sub {
    fill: #fff;
    opacity: 0;
    clip-path: inset(0 100% 0 0);
    transition: opacity 0.25s, clip-path 0s 0.25s;
  }
  .lockup__sub.is-active {
    opacity: 1;
    clip-path: inset(0 0 0 0);
    transition: opacity 0.2s 0.15s, clip-path 0.7s var(--ease-out) 0.15s;
  }

  .showcase__meta {
    position: absolute;
    inset-inline: 5.2%;
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: clamp(10px, 2.1cqi, 12px);
    font-weight: 500;
    letter-spacing: 0.06em;
    font-variant-numeric: tabular-nums;
    text-transform: uppercase;
    color: var(--text-3);
  }
  .showcase__meta--top { top: 7.5%; }
  .showcase__meta--bottom { bottom: 7.5%; }
  .showcase__meta b { color: var(--text); font-weight: 500; }
  .domain { color: var(--text-2); text-transform: none; letter-spacing: 0; }

  .status {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 5px 10px;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-sm);
    color: var(--text-2);
    transition: border-color 0.3s, color 0.3s;
  }
  .status__dot { width: 6px; height: 6px; border-radius: 50%; border: 1px solid currentColor; }
  .status.is-live { color: var(--text); border-color: color-mix(in oklab, var(--c1) 60%, transparent); }
  .status.is-live .status__dot { background: var(--c1); border-color: var(--c1); box-shadow: 0 0 10px var(--c1); }
  .status[href]:hover { background: color-mix(in oklab, var(--c1) 14%, transparent); }

  /* ---------- выбор ниши ---------- */
  .picker {
    display: grid;
    grid-template-columns: repeat(9, minmax(0, 1fr));
    gap: clamp(6px, 0.8vw, 10px);
  }
  .picker__item { position: relative; display: grid; gap: 8px; }
  .picker__tile {
    display: grid;
    border-radius: var(--radius);
    place-items: center;
    aspect-ratio: 1;
    background: var(--bg-elev);
    box-shadow: inset 0 0 0 1px var(--line);
    transition: background-color 0.3s, box-shadow 0.3s, transform 0.4s var(--ease-out);
  }
  .picker__tile :global(svg) {
    width: 46%;
    filter: grayscale(1) brightness(0.75);
    opacity: 0.55;
    transition: filter 0.4s, opacity 0.4s, transform 0.4s var(--ease-out);
  }
  .picker__item:hover .picker__tile { transform: translateY(-3px); box-shadow: inset 0 0 0 1px var(--line-strong); }
  .picker__item:hover .picker__tile :global(svg) { filter: none; opacity: 0.9; }
  .picker__item.is-active .picker__tile {
    background: color-mix(in oklab, var(--c1) 10%, var(--bg-elev));
    box-shadow: inset 0 0 0 1px color-mix(in oklab, var(--c1) 55%, transparent);
  }
  .picker__item.is-active .picker__tile :global(svg) { filter: none; opacity: 1; transform: scale(1.08); }

  .picker__tip {
    position: absolute;
    bottom: calc(100% + 8px);
    left: 50%;
    translate: -50% 4px;
    padding: 4px 8px;
    background: var(--bg-elev-2);
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-sm);
    font-size: 12px;
    font-weight: 500;
    white-space: nowrap;
    color: var(--text);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.2s, translate 0.2s;
  }
  .picker__item:hover .picker__tip,
  .picker__item:focus-visible .picker__tip { opacity: 1; translate: -50% 0; }

  .picker__progress {
    height: 2px;
    border-radius: 2px;
    background: var(--line);
    overflow: hidden;
    position: relative;
  }
  .picker__progress::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--c1);
    transform: scaleX(0);
    transform-origin: left;
