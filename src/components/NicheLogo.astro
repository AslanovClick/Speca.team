---
/** Полный логотип ниши (иконка + SPECA + подпись) из Figma. Текст — currentColor. */
import SpecaWordmark from './SpecaWordmark.astro';
import type { Niche } from '../data/niches';

interface Props { niche: Niche; class?: string }
const { niche, class: cls } = Astro.props;
const gid = `nl-${niche.id}-${Math.random().toString(36).slice(2, 7)}`;
---
<svg class={cls} viewBox="0 0 609 140" fill="none" role="img" aria-label={niche.domain}>
  <defs>
    <linearGradient id={gid} x1="30" y1="0" x2="106" y2="133.6" gradientUnits="userSpaceOnUse">
      <stop offset="0" stop-color={niche.c1} />
      <stop offset="1" stop-color={niche.c2} />
    </linearGradient>
  </defs>
  <path d="M133.626 104.756L104.756 133.626H0V29.1446L29.1446 0H133.626V104.756Z" fill={`url(#${gid})`} />
  <path d="M115.862 47.4634L96.5519 67.5862V42.6515L115.862 22.5287V47.4634Z" fill="#000" />
  <path fill="#000" fill-rule="evenodd" clip-rule="evenodd" d="M85.8038 77.6548L95.8928 67.4588V86.8777L107.816 75.136V100.877L84.4284 123.908H42.6981L19.3104 100.877V75.136L85.8038 9.65517V77.6548ZM32.3797 88.0063L63.5632 118.715L78.4668 104.038V85.5232L69.2955 94.5549V51.6527L32.3797 88.0063Z" />
  <SpecaWordmark />
  <path d={niche.subtitle} fill="currentColor" />
</svg>
