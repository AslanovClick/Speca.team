---
import SpecaLogo from './SpecaLogo.astro';
import { useDict } from '../i18n';

const t = useDict(Astro.currentLocale);
const links = [
  { href: '#partnership', label: t.nav.partnership },
  { href: '#niches', label: t.nav.niches },
  { href: '#how', label: t.nav.how },
  { href: '#about', label: t.nav.team },
  { href: '#jobs', label: t.nav.jobs },
  { href: '#contact', label: t.nav.contact },
];
const langs = [
  { code: 'uk', label: 'UA' },
  { code: 'ru', label: 'RU' },
];
---
<header class="site-header" data-header>
  <div class="container site-header__inner">
    <a href="#top" class="brand" aria-label="Speca">
      <SpecaLogo class="brand__logo" />
    </a>

    <nav class="nav" aria-label="Основна навігація">
      <ul>
        {links.map((l) => (
          <li>
            <a href={l.href} class="nav__link">
              <span class="nav__label">{l.label}</span>
              <span class="nav__line" aria-hidden="true"></span>
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="tools">
      <!-- Переключатель языка: пока только визуально, перевод появится позже -->
      <div class="lang" role="radiogroup" aria-label={t.nav.lang} data-lang style="--i:0">
        <span class="lang__pill" aria-hidden="true"></span>
        {langs.map((l, i) => (
          <button
            class:list={['lang__item', { 'is-active': i === 0 }]}
            type="button"
            role="radio"
            aria-checked={i === 0 ? 'true' : 'false'}
            data-lang-item={i}
          >{l.label}</button>
        ))}
      </div>

      <button class="icon-btn theme-btn" type="button" aria-label={t.nav.toLight} data-theme-toggle
        data-label-light={t.nav.toLight} data-label-dark={t.nav.toDark}>
        <svg class="theme-btn__icon theme-btn__icon--moon" width="18" height="18" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
          <path d="M17 11.5A7 7 0 0 1 8.5 3a7 7 0 1 0 8.5 8.5Z" stroke-linejoin="round" />
        </svg>
        <svg class="theme-btn__icon theme-btn__icon--sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4" />
          <path d="M12 2.5v2M12 19.5v2M4.6 4.6l1.4 1.4M18 18l1.4 1.4M2.5 12h2M19.5 12h2M4.6 19.4 6 18M18 6l1.4-1.4" />
        </svg>
      </button>

      <button class="icon-btn burger" type="button" aria-label={t.nav.menu} aria-expanded="false" aria-controls="mobile-nav" data-burger>
        <span></span><span></span>
      </button>
    </div>
  </div>
</header>

<!-- Мобильное меню вынесено из шапки: внутри элемента с backdrop-filter размытие не работает -->
<div class="mobile-nav" id="mobile-nav" data-mobile-nav aria-hidden="true">
  <ul class="container">
    {links.map((l, i) => <li style={`--i:${i}`}><a href={l.href} tabindex="-1">{l.label}</a></li>)}
  </ul>
</div>

<style>
  .site-header {
    position: fixed;
    inset: 0 0 auto;
    z-index: 50;
    height: var(--header-h);
    transition: background-color 0.4s, border-color 0.4s, backdrop-filter 0.4s;
    border-bottom: 1px solid transparent;
  }
  .site-header.is-scrolled,
  .site-header.is-open {
    background: var(--glass);
    backdrop-filter: blur(16px) saturate(140%);
    -webkit-backdrop-filter: blur(16px) saturate(140%);
    border-color: var(--line);
  }
  .site-header__inner {
    height: 100%;
    display: flex;
    align-items: center;
    gap: 32px;
  }

  .brand { display: flex; align-items: center; flex: none; color: var(--text); transition: opacity 0.2s; }
  .brand:hover { opacity: 0.8; }
  .brand :global(.brand__logo) { height: 30px; width: auto; aspect-ratio: 684 / 134; }

  .nav { margin-inline: auto; }
  .nav ul { display: flex; gap: 4px; list-style: none; margin: 0; padding: 0; }
  /* Gradient underline: подпись слегка увеличивается, линия растёт слева направо */
  .nav__link {
    position: relative;
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    padding: 8px 12px;
    overflow: hidden;
    font-size: 14px;
    font-weight: 500;
    color: var(--text-2);
    transition: color 0.3s;
  }
  .nav__label {
    position: relative;
    z-index: 1;
    transition: transform 0.5s ease;
  }
  .nav__line {
    position: absolute;
    left: 0;
    bottom: 0;
    width: 0;
    height: 1px;
    background: linear-gradient(
      90deg,
      transparent 0%,
      color-mix(in oklab, var(--ink) 35%, transparent) 30%,
      var(--ink) 50%,
      color-mix(in oklab, var(--ink) 35%, transparent) 70%,
      transparent 100%
    );
    transition: width 1s cubic-bezier(0.165, 0.84, 0.44, 1);
  }
  .nav__link:hover,
  .nav__link:focus-visible { color: var(--text); }
  .nav__link:hover .nav__label,
  .nav__link:focus-visible .nav__label { transform: scale(1.12); }
  .nav__link:hover .nav__line,
  .nav__link:focus-visible .nav__line { width: 100%; }

  .tools { display: flex; align-items: center; gap: 8px; margin-left: auto; }
  .nav + .tools { margin-left: 0; }

  /* ---------- языки: плашка переезжает к выбранному ---------- */
  .lang {
    position: relative;
    display: grid;
    grid-template-columns: 1fr 1fr;
    padding: 3px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    font-size: 12px;
    font-weight: 600;
  }
  .lang__pill {
    position: absolute;
    top: 3px;
    bottom: 3px;
    left: 3px;
    width: calc(50% - 3px);
    border-radius: var(--radius-sm);
    background: var(--bg-elev-2);
    box-shadow: inset 0 0 0 1px var(--line);
    transform: translateX(calc(var(--i) * 100%));
    transition: transform 0.45s var(--ease-out);
  }
  .lang__item {
    position: relative;
    z-index: 1;
    min-width: 34px;
    padding: 5px 9px;
    border-radius: var(--radius-sm);
    color: var(--text-3);
    transition: color 0.3s;
  }
  .lang__item:hover { color: var(--text-2); }
  .lang__item.is-active { color: var(--text); }

  .icon-btn {
    display: grid;
    place-items: center;
    width: 38px; height: 38px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    color: var(--text-2);
    transition: color 0.2s, border-color 0.2s;
  }
  .icon-btn:hover { color: var(--text); border-color: var(--line-strong); }

  /* ---------- переключатель темы ---------- */
  .theme-btn { position: relative; overflow: hidden; }
  .theme-btn__icon {
    grid-area: 1 / 1;
    transition: transform 0.5s var(--ease-out), opacity 0.3s;
  }
  /* В тёмной теме показываем солнце (переключить на светлую), в светлой — луну */
  .theme-btn__icon--moon { opacity: 0; transform: rotate(-90deg) scale(0.5); }
  :global([data-theme='light']) .theme-btn__icon--moon { opacity: 1; transform: none; }
  :global([data-theme='light']) .theme-btn__icon--sun { opacity: 0; transform: rotate(90deg) scale(0.5); }

  .burger { display: none; position: relative; }
  .burger span {
    position: absolute;
    left: 11px; right: 11px;
    height: 1.5px;
    background: currentColor;
    transition: transform 0.35s var(--ease-out);
  }
  .burger span:first-child { transform: translateY(-4px); }
  .burger span:last-child { transform: translateY(4px); }
  .is-open .burger span:first-child { transform: rotate(45deg); }
  .is-open .burger span:last-child { transform: rotate(-45deg); }

  /* ---------- мобильное меню: матовое стекло ---------- */
  .mobile-nav {
    position: fixed;
    inset: var(--header-h) 0 0;
    z-index: 49;
    overflow-y: auto;
    background: color-mix(in oklab, var(--bg) 62%, transparent);
    backdrop-filter: blur(28px) saturate(160%);
    -webkit-backdrop-filter: blur(28px) saturate(160%);
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.35s var(--ease-out), visibility 0s 0.35s;
  }
  .mobile-nav.is-open {
    opacity: 1;
    visibility: visible;
    transition: opacity 0.35s var(--ease-out), visibility 0s;
  }
  .mobile-nav ul { list-style: none; margin: 0; padding-top: 24px; padding-bottom: 24px; }
  .mobile-nav li {
    border-bottom: 1px solid var(--line);
    opacity: 0;
    transform: translateY(12px);
    transition: opacity 0.4s var(--ease-out), transform 0.5s var(--ease-out);
  }
  .mobile-nav.is-open li {
    opacity: 1;
    transform: none;
    transition-delay: calc(var(--i) * 50ms + 60ms);
  }
  .mobile-nav a {
    display: block;
    padding: 18px 0;
    font-family: var(--font-display);
    font-size: 26px;
    font-weight: 600;
    text-transform: uppercase;
    color: var(--text);
  }

  @media (max-width: 1100px) {
    .nav { display: none; }
    .nav + .tools { margin-left: auto; }
    .brand :global(.brand__logo) { height: 26px; }
    .burger { display: grid; }
  }
  @media (min-width: 1101px) {
    .mobile-nav { display: none; }
  }
</style>

<script>
  const root = document.documentElement;
  const header = document.querySelector<HTMLElement>('[data-header]')!;
  const burger = header.querySelector<HTMLButtonElement>('[data-burger]')!;
  const menu = document.querySelector<HTMLElement>('[data-mobile-nav]')!;
  const menuLinks = [...menu.querySelectorAll<HTMLAnchorElement>('a')];

  /* ---------- шапка при прокрутке ---------- */
  const onScroll = () => header.classList.toggle('is-scrolled', window.scrollY > 8);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  /* ---------- мобильное меню ---------- */
  const setOpen = (open: boolean) => {
    header.classList.toggle('is-open', open);
    menu.classList.toggle('is-open', open);
    menu.setAttribute('aria-hidden', String(!open));
    menuLinks.forEach((a) => (a.tabIndex = open ? 0 : -1));
    burger.setAttribute('aria-expanded', String(open));
    root.style.overflow = open ? 'hidden' : '';
  };
  burger.addEventListener('click', () => setOpen(!menu.classList.contains('is-open')));
  menu.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).closest('a')) setOpen(false);
  });
  window.addEventListener('keydown', (e) => e.key === 'Escape' && setOpen(false));
  matchMedia('(min-width: 1101px)').addEventListener('change', (e) => e.matches && setOpen(false));

  /* ---------- языки (пока только визуально) ---------- */
  const lang = header.querySelector<HTMLElement>('[data-lang]')!;
  const langItems = [...lang.querySelectorAll<HTMLButtonElement>('[data-lang-item]')];
  const pickLang = (i: number) => {
    lang.style.setProperty('--i', String(i));
    langItems.forEach((b, k) => {
      b.classList.toggle('is-active', k === i);
      b.setAttribute('aria-checked', String(k === i));
    });
  };
  langItems.forEach((b, k) => b.addEventListener('click', () => pickLang(k)));

  /* ---------- тема: круг раскрывается от кнопки ---------- */
  const toggle = header.querySelector<HTMLButtonElement>('[data-theme-toggle]')!;
  const meta = document.querySelector<HTMLMetaElement>('meta[name="theme-color"]');
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

  const syncToggle = () => {
    const light = root.dataset.theme === 'light';
    toggle.setAttribute('aria-label', light ? toggle.dataset.labelDark! : toggle.dataset.labelLight!);
    toggle.title = toggle.getAttribute('aria-label')!;
    meta?.setAttribute('content', light ? '#f4f4f7' : '#060608');
  };
  const applyTheme = (theme: 'light' | 'dark') => {
    root.dataset.theme = theme;
    try { localStorage.setItem('speca-theme', theme); } catch {}
    syncToggle();
  };
  syncToggle();

  toggle.addEventListener('click', () => {
    const next = root.dataset.theme === 'light' ? 'dark' : 'light';
    const vt = (document as any).startViewTransition?.bind(document);
    if (!vt || reduced) { applyTheme(next); return; }

    const r = toggle.getBoundingClientRect();
    const x = r.left + r.width / 2;
    const y = r.top + r.height / 2;
    const radius = Math.hypot(Math.max(x, innerWidth - x), Math.max(y, innerHeight - y));

    const transition = vt(() => applyTheme(next));
    transition.ready.then(() => {
      root.animate(
        { clipPath: [`circle(0px at ${x}px ${y}px)`, `circle(${radius}px at ${x}px ${y}px)`] },
        { duration: 750, easing: 'cubic-bezier(0.65, 0, 0.35, 1)', pseudoElement: '::view-transition-new(root)' },
      );
    });
  });
</script>
